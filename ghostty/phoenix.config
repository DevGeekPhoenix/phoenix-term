# ───────────────────────────────────────────────────────────────
#  Ghostty — default palette, Phoenix wallpaper background.
#  Every custom palette / fg / bg directive has been removed; Ghostty
#  uses its built-in defaults so colors are what you get out of the box.
# ───────────────────────────────────────────────────────────────

# ── Background image (pre-darkened to 30% brightness) ──
# The brightness is baked into the file itself (phoenix-bg.jpg) and the
# image renders at opacity 1.0 — that keeps the colors true (no gray
# blend artefacts) while still producing a subtle, low-brightness bg.
# To re-darken from the original:
#   python3 -c "from PIL import Image,ImageEnhance; \
#     im=Image.open('~/.config/ghostty/phoenix-bg-source.jpg').convert('RGB'); \
#     ImageEnhance.Brightness(im).enhance(0.30).save('~/.config/ghostty/phoenix-bg.jpg','JPEG',quality=92)"
background-image          = phoenix-bg.jpg
background-image-opacity  = 1.0
background-image-fit      = cover
background-image-position = center
background-opacity        = 1

# ── Primary text color ─────────────────────────────────────────
# Light sea green — also used by the Starship pills, so typed text
# and the prompt pill text share the same hue.
foreground = #20b2aa

# ── Font ───────────────────────────────────────────────────────
font-family   = "ComicShannsMono Nerd Font Mono"
font-size     = 14
font-feature  = +liga
font-thicken  = true
adjust-cell-height = 10%

# ── Window / chrome ────────────────────────────────────────────
window-padding-x        = 14
window-padding-y        = 12
window-padding-balance  = true
window-decoration       = true
window-save-state       = always
macos-titlebar-style    = transparent
macos-option-as-alt     = true
background-blur-radius  = 20

# ── Cursor / scrolling ─────────────────────────────────────────
cursor-style       = block
cursor-style-blink = true
mouse-hide-while-typing = true
copy-on-select     = clipboard
confirm-close-surface = false
scrollback-limit   = 100000

# ── Shell integration (zsh) ────────────────────────────────────
shell-integration         = zsh
shell-integration-features = cursor,sudo,title

# ── Splits / tabs keybinds (Cmd-based, macOS muscle memory) ────
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+t=new_tab
keybind = cmd+shift+enter=toggle_fullscreen
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+k=clear_screen
