# ── Phoenix wallpaper background ─────────────────────────────────────────
background-image          = phoenix-bg.jpg
background-image-opacity  = 1.0
background-image-fit      = cover
background-image-position = center
background-opacity        = 1

# ── Primary text color ─────────────────────────────────────────

foreground = #20b2aa

# ── Font ───────────────────────────────────────────────────────

font-family   = "ComicShannsMono Nerd Font Mono"
font-size     = 14
font-feature  = +liga
font-thicken  = true
adjust-cell-height = 10%

# ── Window / chrome ────────────────────────────────────────────

window-padding-x        = 14
window-padding-y        = 12
window-padding-balance  = true
window-decoration       = true
window-save-state       = always
macos-titlebar-style    = transparent
macos-option-as-alt     = true
background-blur-radius  = 20

# ── Cursor / scrolling ─────────────────────────────────────────

cursor-style       = block
cursor-style-blink = true
mouse-hide-while-typing = true
copy-on-select     = clipboard
confirm-close-surface = false
scrollback-limit   = 100000

# ── Shell integration (zsh) ────────────────────────────────────

# Force zsh login shell — phoenix.zsh is zsh-only and on Linux the default
# is usually bash, which would skip the auto-tmux exec.
command                    = zsh -l
shell-integration          = zsh
shell-integration-features = cursor,sudo,title

# ── Splits / tabs keybinds (Cmd-based, macOS muscle memory) ────

keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+t=new_tab
keybind = cmd+shift+enter=toggle_fullscreen
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+k=text:\x0c

# ── User overrides (managed by `phoenix-term settings`) ─────────

# Mode toggle writes to phoenix-user.conf so this main config stays untouched
# (symlink installs stay clean).
config-file = ?~/.config/ghostty/phoenix-user.conf
