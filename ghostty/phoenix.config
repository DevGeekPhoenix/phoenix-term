# ── Phoenix wallpaper background ─────────────────────────────────────────
background-image          = phoenix-bg.jpg
background-image-opacity  = 1.0
background-image-fit      = cover
background-image-position = center
background-opacity        = 1

# ── Primary text color ─────────────────────────────────────────

foreground = #20b2aa

# ── Font ───────────────────────────────────────────────────────

font-family   = "ComicShannsMono Nerd Font Mono"
font-size     = 14
font-feature  = +liga
font-thicken  = true
adjust-cell-height = 10%

# ── Window / chrome ────────────────────────────────────────────

window-padding-x        = 14
window-padding-y        = 12
window-padding-balance  = true
window-decoration       = true
window-save-state       = always
macos-titlebar-style    = transparent
macos-option-as-alt     = true
background-blur-radius  = 20

# ── Cursor / scrolling ─────────────────────────────────────────

cursor-style       = block
cursor-style-blink = true
mouse-hide-while-typing = true
copy-on-select     = clipboard
confirm-close-surface = false
scrollback-limit   = 100000

# ── Shell integration (zsh) ────────────────────────────────────

# Force zsh login shell — phoenix.zsh is zsh-only and on Linux the default
# is usually bash, which would skip the auto-tmux exec.
command                    = zsh -l
shell-integration          = zsh
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# ── Window keybinds (Cmd-based, macOS muscle memory) ───────────

keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind
keybind = cmd+shift+enter=toggle_fullscreen

# ── tmux windows-as-tabs ───────────────────────────────────────
# cmd (= super) combos are grabbed by Linux DEs before reaching Ghostty,
# so each has a ctrl+shift mirror — the Linux terminal convention.

keybind = cmd+t=text:\x01c
keybind = cmd+w=text:\x01X
keybind = cmd+alt+right=text:\x01n
keybind = cmd+alt+left=text:\x01p
keybind = ctrl+shift+t=text:\x01c
keybind = ctrl+shift+w=text:\x01X
keybind = ctrl+shift+right=text:\x01n
keybind = ctrl+shift+left=text:\x01p
keybind = ctrl+shift+enter=toggle_fullscreen
keybind = ctrl+1=text:\x011
keybind = ctrl+2=text:\x012
keybind = ctrl+3=text:\x013
keybind = ctrl+4=text:\x014
keybind = ctrl+5=text:\x015
keybind = ctrl+6=text:\x016
keybind = ctrl+7=text:\x017
keybind = ctrl+8=text:\x018
keybind = ctrl+9=text:\x019

# Cheat sheet — sends the tmux prefix (Ctrl-A) then `?`, which opens the popup.
keybind = cmd+slash=text:\x01?
keybind = ctrl+shift+slash=text:\x01?

# ── User overrides (managed by `phoenix-term settings`) ─────────

# Mode toggle writes to phoenix-user.conf so this main config stays untouched
# (symlink installs stay clean).
config-file = ?~/.config/ghostty/phoenix-user.conf
