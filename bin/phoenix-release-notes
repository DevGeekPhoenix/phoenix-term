#!/usr/bin/env python3
# Phoenix Term release notes — fetched from GitHub, paged in a cheat-style popup TUI.

import json
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import termios
import textwrap
import tty
import urllib.request

SEA = (32, 178, 170)
MUTED = (71, 82, 98)
DIM = (120, 120, 120)
CHIP = (28, 32, 39)
B = "\033[1m"
R = "\033[0m"


def fg(r, g, b):
    return f"\033[38;2;{r};{g};{b}m"


def bg(r, g, b):
    return f"\033[48;2;{r};{g};{b}m"


SELF = os.path.realpath(__file__)
REPO = os.path.dirname(os.path.dirname(SELF))
GH_REPO = os.environ.get("PHOENIX_GH_REPO", "DevGeekPhoenix/phoenix-term")


def installed_tag():
    vf = os.path.join(REPO, ".version")
    if os.path.isfile(vf):
        with open(vf) as f:
            t = f.readline().strip()
        if t:
            return t
    if os.path.isdir(os.path.join(REPO, ".git")):
        try:
            p = subprocess.run(
                ["git", "-C", REPO, "describe", "--tags", "--abbrev=0", "HEAD"],
                capture_output=True, text=True, timeout=5)
            return p.stdout.strip() or None
        except Exception:
            return None
    return None


def latest_tag():
    try:
        with urllib.request.urlopen(
                f"https://github.com/{GH_REPO}/releases/latest", timeout=8) as r:
            url = r.geturl()
        if "/tag/" in url:
            return url.rsplit("/tag/", 1)[1]
    except Exception:
        pass
    return None


def fetch_release(tag):
    req = urllib.request.Request(
        f"https://api.github.com/repos/{GH_REPO}/releases/tags/{tag}",
        headers={"User-Agent": "phoenix-term"})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)


def fetch_releases_list():
    req = urllib.request.Request(
        f"https://api.github.com/repos/{GH_REPO}/releases?per_page=100",
        headers={"User-Agent": "phoenix-term"})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)


def collect_range(releases, from_tag, to_tag):
    picked, started = [], False
    for rel in releases:
        t = rel.get("tag_name")
        if not started:
            if t == to_tag:
                started = True
            else:
                continue
        if from_tag and t == from_tag:
            break
        picked.append(rel)
    return picked


def render_md(text):
    bat = shutil.which("bat") or os.path.expanduser("~/.local/bin/bat")
    if bat and os.access(bat, os.X_OK):
        try:
            p = subprocess.run(
                [bat, "-l", "md", "--style=plain", "--color=always", "--paging=never"],
                input=text, capture_output=True, text=True, timeout=10)
            if p.returncode == 0:
                return p.stdout
        except Exception:
            pass
    return text


def build_lines(rel, tag, width):
    body = rel.get("body") or "_(no release notes)_"
    wrapped = []
    for raw in body.splitlines():
        if len(raw) > width:
            wrapped.extend(textwrap.wrap(
                raw, width, subsequent_indent="  ",
                break_long_words=False, break_on_hyphens=False) or [""])
        else:
            wrapped.append(raw)
    rendered = render_md("\n".join(wrapped)).splitlines()

    name = rel.get("name") or ""
    date = (rel.get("published_at") or "")[:10]
    head = f"{fg(*SEA)}{B}Phoenix Term {tag}{R}"
    if name and name != tag:
        head += f"  {fg(*DIM)}—  {name}{R}"
    lines = [head]
    if date:
        lines.append(f"{fg(*DIM)}released {date}{R}")
    lines.append(f"{fg(*MUTED)}{'─' * min(width, 70)}{R}")
    lines.append("")
    lines.extend(rendered)
    lines.append("")
    lines.append(f"{fg(*DIM)}https://github.com/{GH_REPO}/releases/tag/{tag}{R}")
    return lines


BGD = (12, 15, 17)
_state = {"maxscroll": 0, "body": {}}


def tab_strip(rels, tab, width):
    raw = [f" {i + 1} {tag} " for i, (_, tag) in enumerate(rels)]
    budget = max(10, width - 4)
    lo = hi = tab
    used = len(raw[tab])
    while True:
        grew = False
        if lo > 0 and used + len(raw[lo - 1]) + 1 <= budget:
            lo -= 1
            used += len(raw[lo]) + 1
            grew = True
        if hi < len(raw) - 1 and used + len(raw[hi + 1]) + 1 <= budget:
            hi += 1
            used += len(raw[hi]) + 1
            grew = True
        if not grew:
            break
    parts = [fg(*DIM) + "‹ " + R] if lo > 0 else []
    for i in range(lo, hi + 1):
        if i == tab:
            parts.append(bg(*SEA) + fg(*BGD) + B + raw[i] + R)
        else:
            parts.append(fg(*MUTED) + raw[i] + R)
        parts.append(" ")
    if hi < len(raw) - 1:
        parts.append(fg(*DIM) + "›" + R)
    return "  " + "".join(parts)


def body_lines(rels, tab, width):
    key = (tab, width)
    cache = _state["body"]
    if key not in cache:
        rel, tag = rels[tab]
        cache[key] = build_lines(rel, tag, width)
    return cache[key]


def render(rels, tab, scroll):
    W, H = shutil.get_terminal_size((100, 30))
    out = ["\033[H\033[2J\033[?25l"]
    left = (f"  {fg(*SEA)}{B}Phoenix Term{R}  "
            f"{bg(*CHIP)}{fg(*SEA)} What's New {R}")
    right = f"{fg(*MUTED)}phoenix-term notes{R}  "
    pad = max(1, W - 14 - 12 - 20 - 4)
    out.append(f"\033[1;1H{left}{' ' * pad}{right}")

    out.append(f"\033[3;1H{tab_strip(rels, tab, W)}")

    lines = body_lines(rels, tab, max(40, W - 6))
    ctop, cbot = 5, H - 2
    view = cbot - ctop + 1
    maxscroll = max(0, len(lines) - view)
    _state["maxscroll"] = maxscroll
    scroll = max(0, min(scroll, maxscroll))
    for i in range(view):
        idx = scroll + i
        if idx < len(lines):
            out.append(f"\033[{ctop + i};3H{lines[idx]}")

    n = len(rels)
    nav = f"  ←/→ or 1–{min(n, 9)} versions" if n > 1 else "  "
    foot = (f"{fg(*MUTED)}{nav}    ↑/↓ scroll"
            + ("  ▾" if scroll < maxscroll else "")
            + ("  ▴" if scroll > 0 else "") + f"    q quit{R}")
    out.append(f"\033[{H};1H{foot}")
    sys.stdout.write("".join(out))
    sys.stdout.flush()
    return scroll


def read_key(fd):
    ch = os.read(fd, 1)
    if ch == b"\x1b":
        r, _, _ = select.select([fd], [], [], 0.05)
        if r:
            ch += os.read(fd, 2)
    return ch.decode("utf-8", "ignore")


def run_tui(rels):
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    winch = [True]
    signal.signal(signal.SIGWINCH, lambda *a: winch.__setitem__(0, True))
    tab, scroll = 0, 0
    n = len(rels)
    try:
        tty.setcbreak(fd)
        scroll = render(rels, tab, scroll)
        while True:
            r, _, _ = select.select([fd], [], [], 0.25)
            if winch[0]:
                winch[0] = False
                _state["body"].clear()
                scroll = render(rels, tab, scroll)
            if not r:
                continue
            k = read_key(fd)
            view = shutil.get_terminal_size((100, 30))[1] - 6
            if k in ("q", "\x1b", "\x03"):
                break
            elif n > 1 and k in ("\t", "l", "\x1b[C"):
                tab, scroll = (tab + 1) % n, 0
            elif n > 1 and k in ("h", "\x1b[D", "\x1b[Z"):
                tab, scroll = (tab - 1) % n, 0
            elif k.isdigit() and 1 <= int(k) <= min(n, 9):
                tab, scroll = int(k) - 1, 0
            elif k in ("j", "\x1b[B"):
                scroll = min(scroll + 1, _state["maxscroll"])
            elif k in ("k", "\x1b[A"):
                scroll = max(scroll - 1, 0)
            elif k in (" ", "\x1b[6"):
                scroll = min(scroll + view, _state["maxscroll"])
            elif k in ("b", "\x1b[5"):
                scroll = max(scroll - view, 0)
            elif k == "g":
                scroll = 0
            elif k == "G":
                scroll = _state["maxscroll"]
            else:
                continue
            scroll = render(rels, tab, scroll)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\033[?25h\033[H\033[2J")
        sys.stdout.flush()


def print_plain(rels):
    for i, (rel, tag) in enumerate(rels):
        if i:
            print("\n" + "─" * 60 + "\n")
        name = rel.get("name") or ""
        date = (rel.get("published_at") or "")[:10]
        print(f"Phoenix Term {tag}" + (f" — {name}" if name and name != tag else ""))
        if date:
            print(f"released {date}")
        print()
        print(rel.get("body") or "(no release notes)")
        print()
        print(f"https://github.com/{GH_REPO}/releases/tag/{tag}")


def load_notes(spec):
    # spec is a single tag, or a `from..to` range (the gap since last update).
    if ".." in spec:
        from_tag, _, to_tag = spec.partition("..")
        from_tag, to_tag = from_tag.strip(), to_tag.strip()
    else:
        from_tag, to_tag = "", spec
    for t in (from_tag, to_tag):
        if t and not re.fullmatch(r"[A-Za-z0-9._-]+", t):
            print(f"phoenix-release-notes: invalid tag: {t}", file=sys.stderr)
            sys.exit(1)
    if from_tag:
        picked = collect_range(fetch_releases_list(), from_tag, to_tag)
        if not picked:
            picked = [fetch_release(to_tag)]
        return to_tag, [(r, r.get("tag_name") or to_tag) for r in picked]
    return to_tag, [(fetch_release(to_tag), to_tag)]


def main():
    raw = sys.argv[1:]
    inline = "--inline" in raw
    args = [a for a in raw if a != "--inline"]
    spec = args[0] if args else (installed_tag() or latest_tag())
    if not spec:
        print("phoenix-release-notes: couldn't determine a version", file=sys.stderr)
        sys.exit(1)

    try:
        to_tag, rels = load_notes(spec)
    except SystemExit:
        raise
    except Exception:
        ref = spec.rsplit("..", 1)[-1]
        print(f"couldn't fetch release notes for {ref} (offline, or GitHub rate limit)",
              file=sys.stderr)
        print(f"view online: https://github.com/{GH_REPO}/releases",
              file=sys.stderr)
        sys.exit(1)

    if not inline and os.environ.get("TMUX") and sys.stdout.isatty():
        os.execvp("tmux", [
            "tmux", "display-popup", "-E", "-w", "80%", "-h", "75%",
            f"exec '{SELF}' --inline '{spec}'",
        ])
    if sys.stdout.isatty():
        run_tui(rels)
    else:
        print_plain(rels)


if __name__ == "__main__":
    main()
