#!/usr/bin/env bash
# Spawned by tmux's session-created hook; sets up banner pane + sysmon sidebar.

set -e
[ -n "$TMUX" ] || exit 0

[ -f "$HOME/.config/phoenix-term/config.zsh" ] && source "$HOME/.config/phoenix-term/config.zsh"

PHOENIX_BG_MODE_VAL="${PHOENIX_BG_MODE:-image}"
PHOENIX_BG_COLOR_VAL="${PHOENIX_BG_COLOR:-#0c0f11}"
if [ "$PHOENIX_BG_MODE_VAL" = "color" ]; then
  tmux set-option -g pane-border-style "fg=#1c2027,bg=$PHOENIX_BG_COLOR_VAL" 2>/dev/null || true
  tmux set-option -g pane-active-border-style "fg=#1c2027,bg=$PHOENIX_BG_COLOR_VAL" 2>/dev/null || true
else
  tmux set-option -g pane-border-style "fg=#1c2027" 2>/dev/null || true
  tmux set-option -g pane-active-border-style "fg=#1c2027" 2>/dev/null || true
fi

NAME="${PHOENIX_NAME:-DEV PHOENIX}"
BANNER_HEIGHT=$(figlet -f ANSI_Shadow -w 999 "$NAME" 2>/dev/null \
                | sed '/^[[:space:]]*$/d' \
                | wc -l \
                | tr -d ' ')
[ -z "$BANNER_HEIGHT" ] || [ "$BANNER_HEIGHT" -lt 1 ] 2>/dev/null && BANNER_HEIGHT=6
SYSMON_WIDTH=36

# Capture the main pane id BEFORE any splits — after splits, "current active
# pane" can race with banner/sysmon's own select-pane calls.
main_pane=$(tmux list-panes -F '#{pane_id}' | head -1)

if [ "$PHOENIX_BG_MODE_VAL" = "color" ]; then
  tmux select-pane -t "$main_pane" -P "bg=$PHOENIX_BG_COLOR_VAL" 2>/dev/null || true
else
  tmux select-pane -t "$main_pane" -P 'bg=default' 2>/dev/null || true
fi

case "${PHOENIX_BANNER_STICKY:-sticky}" in
  sticky)
    existing=$(tmux list-panes -F '#{pane_id} #{pane_title}' | awk '$2=="phoenix-banner"{print $1; exit}')
    if [ -z "$existing" ]; then
      tmux split-window -t "$main_pane" -v -b -l "$BANNER_HEIGHT" \
        "exec $HOME/.local/bin/phoenix-banner" 2>/dev/null || true
      banner_pane=$(tmux list-panes -F '#{pane_id} #{pane_top}' \
                    | awk -v m="$main_pane" '$1!=m && $2=="0"{print $1; exit}')
      [ -n "$banner_pane" ] && tmux select-pane -t "$banner_pane" -T phoenix-banner 2>/dev/null || true
    fi
    ;;
esac

existing_sysmon=$(tmux list-panes -F '#{pane_id} #{pane_title}' | awk '$2=="phoenix-sysmon"{print $1; exit}')
if [ -z "$existing_sysmon" ]; then
  tmux split-window -t "$main_pane" -h -l "$SYSMON_WIDTH" \
    "exec $HOME/.local/bin/phoenix-sysmon" 2>/dev/null || true
  sysmon_pane=$(tmux list-panes -F '#{pane_id} #{pane_left}' \
                | awk '$2>0 && $2!="0"{print $1; exit}')
  [ -n "$sysmon_pane" ] && tmux select-pane -t "$sysmon_pane" -T phoenix-sysmon 2>/dev/null || true
fi

tmux select-pane -t "$main_pane" 2>/dev/null || true
