#!/usr/bin/env bash
# Resume a parked tab: move a window from phoenix-parked into the current session.

set -e

[ -n "$TMUX" ] || { echo "phoenix-resume must be run inside tmux"; exit 1; }

cur=$(tmux display-message -p '#{session_name}')

list() {
  tmux list-windows -t phoenix-parked -F '#{window_id}	#{window_name}' 2>/dev/null
}

sea=$'\e[38;2;32;178;170m'; dim=$'\e[38;2;120;120;120m'; r=$'\e[0m'

if ! tmux has-session -t phoenix-parked 2>/dev/null || [ -z "$(list)" ]; then
  printf '\n  %sNo parked tabs.%s\n\n  %sCtrl-A d%s parks the current tab so you can resume it here.\n\n  press any key…' \
    "$sea" "$r" "$dim" "$r"
  read -rsn1 _ || true
  exit 0
fi

pick=$(list | fzf --with-nth=2.. --delimiter='\t' \
  --prompt='resume ▸ ' --header='enter resume · ctrl-x kill' --reverse --height=100% \
  --color='fg+:#20b2aa,prompt:#20b2aa,header:#7a828c,pointer:#20b2aa,marker:#20b2aa,border:#20b2aa,info:#7a828c' \
  --expect=ctrl-x) || exit 0

key=$(printf '%s\n' "$pick" | sed -n '1p')
winid=$(printf '%s\n' "$pick" | sed -n '2p' | cut -f1)
[ -n "$winid" ] || exit 0

if [ "$key" = "ctrl-x" ]; then
  tmux kill-window -t "$winid"
  exec "$0"
fi

tmux move-window -s "$winid" -t "${cur}:"
tmux select-window -t "$winid"
