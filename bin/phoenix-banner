#!/usr/bin/env bash
# Sticky welcome-banner pane (figlet name pinned at top of tmux). Redraws on resize.

set -e

if [ -f "$HOME/.config/phoenix-term/config.zsh" ]; then
  __phx_pre="$(env | grep '^PHOENIX_' || true)"
  source "$HOME/.config/phoenix-term/config.zsh"
  __phx_nl=$'\n'
  while IFS= read -r __phx_l; do
    case "$__phx_l" in *=*) ;; *) continue ;; esac
    case "${__phx_nl}${__PHOENIX_CFG_SNAP:-}${__phx_nl}" in
      *"${__phx_nl}${__phx_l}${__phx_nl}"*) ;;
      *) export "${__phx_l%%=*}=${__phx_l#*=}" ;;
    esac
  done <<EOF
$__phx_pre
EOF
  unset __phx_pre __phx_nl __phx_l
fi

NAME="${PHOENIX_NAME:-DEV PHOENIX}"

if [[ -n "${TMUX_PANE:-}" ]] && command -v tmux >/dev/null 2>&1; then
  if [[ "${PHOENIX_BG_MODE:-image}" == "color" ]]; then
    tmux select-pane -t "$TMUX_PANE" -P "bg=${PHOENIX_BG_COLOR:-#0c0f11}" 2>/dev/null || true
  else
    tmux select-pane -t "$TMUX_PANE" -P 'bg=default' 2>/dev/null || true
  fi
  tmux select-pane -t "$TMUX_PANE" -d 2>/dev/null || true
fi
SEA=$'\e[38;2;32;178;170m'
DIM=$'\e[38;2;120;120;120m'
B=$'\e[1m'
R=$'\e[0m'

render() {
  local cols art width lpad pad
  # `tput cols` in a freshly-spawned pane can return 80 before pty size
  # negotiation completes — trust tmux's pane_width first.
  if [[ -n "${TMUX_PANE:-}" ]] && command -v tmux >/dev/null 2>&1; then
    cols=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_width}' 2>/dev/null)
  fi
  cols=${cols:-$(tput cols 2>/dev/null || echo "${COLUMNS:-80}")}
  printf '\033[H\033[2J\033[3J'

  # `-w 999` prevents figlet wrapping when visible width fits but byte count
  # (multi-byte block glyphs) overflows figlet's terminal-width idea.
  if command -v figlet >/dev/null 2>&1; then
    art=$(figlet -f ANSI_Shadow -w 999 "$NAME" 2>/dev/null \
          || figlet -w 999 "$NAME" 2>/dev/null \
          || echo "$NAME")
  else
    art="$NAME"
  fi

  # ANSI_Shadow ≈ 8 cols/glyph. Byte-length awk and non-UTF8 python3 in
  # run-shell both miscount; approximate from input length instead.
  width=$(( ${#NAME} * 8 ))
  lpad=$(( (cols - width) / 2 ))
  (( lpad < 0 )) && lpad=0
  pad=$(printf '%*s' "$lpad" '')

  # Skip whitespace-only rows — figlet emits a trailing one which, when the
  # pane height matches content exactly, clobbers the bottom shadow (the
  # write to "row N+1" gets clamped to row N).
  local row=1
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    printf '\033[%d;1H%s%s%s%s%s' "$row" "$pad" "$SEA" "$B" "$line" "$R"
    row=$((row + 1))
  done <<<"$art"
}

cleanup() { printf '\033[?25h\n'; exit 0; }
trap cleanup INT TERM
# Bash's signal-while-`wait` behavior is unreliable; the WINCH handler sets
# a dirty flag and the poll loop acts on it.
__phoenix_dirty=1
trap '__phoenix_dirty=1' WINCH

cur_size() {
  if [[ -n "${TMUX_PANE:-}" ]] && command -v tmux >/dev/null 2>&1; then
    tmux display-message -p -t "$TMUX_PANE" '#{pane_width}x#{pane_height}' 2>/dev/null
  else
    printf '%sx%s' "$(tput cols 2>/dev/null || echo 80)" "$(tput lines 2>/dev/null || echo 8)"
  fi
}

printf '\033[?25l'

# split-window can briefly report a default pane size before its layout
# settles on the requested -l value — render twice so the second draw lands
# at the final size.
render
sleep 0.3
render
last_size=$(cur_size)
__phoenix_dirty=0

while true; do
  size=$(cur_size)
  if (( __phoenix_dirty )) || [[ "$size" != "$last_size" ]]; then
    render
    last_size="$size"
    __phoenix_dirty=0
  fi
  sleep 1
done
