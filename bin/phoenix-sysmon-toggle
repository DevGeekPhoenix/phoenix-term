#!/usr/bin/env bash
# Toggle the tmux sidebar pane running phoenix-sysmon.

set -e

[ -n "$TMUX" ] || { echo "phoenix-sysmon-toggle must be run inside tmux"; exit 1; }

existing=$(tmux list-panes -F '#{pane_id} #{pane_title}' | awk '$2=="phoenix-sysmon"{print $1; exit}')

if [ -n "$existing" ]; then
  tmux kill-pane -t "$existing"
else
  # 36 cols = block-art clock (HH:MM:SS = 33) + padding.
  tmux split-window -h -l 36 "exec $HOME/.local/bin/phoenix-sysmon"
  tmux select-pane -T phoenix-sysmon
  tmux last-pane
fi
