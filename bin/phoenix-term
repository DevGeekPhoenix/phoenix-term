#!/usr/bin/env bash
# phoenix-term — everyday CLI wrapper around install.sh.

set -e

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case "$link" in
    /*) SELF="$link" ;;
    *)  SELF="$(cd "$(dirname "$SELF")" && pwd)/$link" ;;
  esac
done
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"
INSTALL="$REPO/install.sh"

if [ ! -f "$INSTALL" ]; then
  echo "phoenix-term: cannot find install.sh at $INSTALL" >&2
  exit 1
fi

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
  install)                exec bash "$INSTALL" "$@" ;;
  update)                 exec bash "$INSTALL" --update "$@" ;;
  check)                  exec bash "$INSTALL" --check "$@" ;;
  doctor)                 exec bash "$INSTALL" --doctor "$@" ;;
  uninstall)              exec bash "$INSTALL" --uninstall "$@" ;;
  revert|rollback)        exec bash "$INSTALL" --revert "$@" ;;
  backups|list-backups)   exec bash "$INSTALL" --backups "$@" ;;
  version|-V|--version)   exec bash "$INSTALL" --version ;;
  settings|config)
    if [ $# -eq 0 ]; then
      exec bash "$INSTALL" --settings --menu
    else
      exec bash "$INSTALL" --settings "$@"
    fi
    ;;
  where)                  echo "$REPO" ;;
  help|-h|--help|"")
    cat <<EOF
phoenix-term — manage your Phoenix Term install

Usage:
  phoenix-term install        Run or refresh the installer (idempotent)
  phoenix-term update         Download the latest GitHub Release and replace
                              the install (auto-backs up the prior version)
  phoenix-term check          Re-check whether a newer release exists
  phoenix-term revert         Roll back to the most recent backup (alias: rollback)
  phoenix-term backups        List available backups (alias: list-backups)
  phoenix-term doctor         Healthcheck symlinks, packages, shell wiring
  phoenix-term version        Show the installed release tag
  phoenix-term settings       Interactive preferences menu
    phoenix-term settings --list             Print current values
    phoenix-term settings --get KEY          Print one value
    phoenix-term settings --set KEY=VALUE    Set one value
  phoenix-term uninstall      Remove symlinks, restore most-recent backups
  phoenix-term where          Print the repo path ($REPO)
  phoenix-term help           Show this help

Updates are GitHub Releases (https://github.com/DevGeekPhoenix/phoenix-term/releases).
Each 'update' rotates the prior install to <install-dir>.bak-<timestamp>; 'revert'
restores the most recent one (and rotates the current install aside, so a
revert is itself revertable).

Flags after the subcommand are passed through (e.g. install --dry-run).
EOF
    ;;
  *)
    echo "phoenix-term: unknown subcommand '$cmd'" >&2
    echo "Try \`phoenix-term help\`." >&2
    exit 2
    ;;
esac
