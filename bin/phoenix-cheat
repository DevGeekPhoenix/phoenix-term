#!/usr/bin/env python3
# Phoenix Term keyboard + command cheat sheet. Tabbed TUI, pure stdlib.

import os, re, sys, select, shutil, signal, textwrap

def fg(r, g, b): return f"\033[38;2;{r};{g};{b}m"
def bg(r, g, b): return f"\033[48;2;{r};{g};{b}m"

R = "\033[0m"
B = "\033[1m"

SEA   = (32, 178, 170)
BLUE  = (17, 183, 212)
GREEN = (0, 168, 132)
GOLD  = (241, 177, 21)
PINK  = (212, 110, 192)
RED   = (227, 85, 53)
MUTED = (120, 128, 140)
FGCOL = (190, 198, 208)
BGD   = (12, 15, 17)
CHIP  = (28, 32, 39)

ACCENTS = [SEA, BLUE, GREEN, GOLD, PINK, RED]

IS_MACOS = sys.platform == "darwin"

def k(mac, linux): return mac if IS_MACOS else linux

# Linux: Super keybinds only work when the DE hasn't grabbed the combo, so the
# sheet probes the DE config and advertises them only when verified free.
def _de_grabs():
    if IS_MACOS:
        return None
    import subprocess
    txt = []
    for cmd in (("gsettings", "list-recursively"),
                ("dconf", "dump", "/"),
                ("xfconf-query", "-c", "xfce4-keyboard-shortcuts", "-lv")):
        try:
            txt.append(subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout)
        except Exception:
            pass
    try:
        with open(os.path.expanduser("~/.config/kglobalshortcutsrc")) as f:
            txt.append("".join(l for l in f if "=none" not in l.lower()))
    except OSError:
        pass
    return "\n".join(txt).lower()

_GRABS = _de_grabs()

_START = r"(^|['\"=,/\[\s])"

def _super_free(gtk, kde):
    if not _GRABS:
        return False
    return not (re.search(_START + gtk, _GRABS, re.M) or re.search(kde, _GRABS, re.M))

SUP_T     = _super_free(r"<super>t\b", r"meta\+t\b")
SUP_W     = _super_free(r"<super>w\b", r"meta\+w\b")
SUP_NAV   = (_super_free(r"(<super><alt>|<alt><super>)left\b", r"meta\+alt\+left\b")
             and _super_free(r"(<super><alt>|<alt><super>)right\b", r"meta\+alt\+right\b"))
SUP_FS    = _super_free(r"(<super><shift>|<shift><super>)return\b", r"meta\+shift\+(return|enter)\b")
SUP_CHEAT = _super_free(r"<super>slash\b", r"meta\+(slash|/)")

